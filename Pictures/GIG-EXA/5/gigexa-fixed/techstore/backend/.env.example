# Server
PORT=5000
NODE_ENV=development

# Database (use a MongoDB Atlas URI in production)
MONGO_URI=mongodb://localhost:27017/gigexa

# Auth — REQUIRED in production. Use a long random string.
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000

# Default admin account created on first run — set these before going live
ADMIN_EMAIL=admin@gigexa.com.bd
ADMIN_PASSWORD=change_this_admin_password
